# ─── jibbit.ch ────────────────────────────────────────────────
# Caddy generiert automatisch Let's Encrypt Zertifikate.
#
# ACHTUNG — die Domains stehen hier NICHT mehr fest, und das ist Absicht.
#
# Caddy holt fuer jede hier genannte Domain sofort beim Start ein
# Zertifikat. Steht eine Domain drin, deren DNS noch woanders zeigt (etwa
# auf die alte Odoo-Instanz), schlaegt die ACME-Pruefung fehl — und zwar
# wiederholt. Let's Encrypt sperrt daraufhin genau diesen Hostnamen fuer
# Stunden. Man verliert also ausgerechnet in dem Moment die Faehigkeit,
# ein Zertifikat zu bekommen, in dem man umziehen will.
#
# Deshalb kommen die Domains aus der Umgebung (docker-compose.yml ->
# caddy.environment, gespeist aus .env). Im Testbetrieb setzt man dort
# Testdomains; erst beim echten Umzug die produktiven.

{
	# Email für Let's Encrypt ACME
	email admin@jibbit.ch
}

# API Backend
{$API_DOMAIN} {
	reverse_proxy medusa:9000

	# Security Headers
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-XSS-Protection "0"
		-Server
	}

	# Webhook-Endpoint: Keine Rate-Limits (zahls.ch-Retries)
	handle /hooks/payment/* {
		reverse_proxy medusa:9000
	}
}

# Storefront (Next.js)
{$SHOP_DOMAINS} {
	# Beide Zweige als `handle` — Geschwister-handle-Blöcke werden in
	# Schreibreihenfolge geprüft und der erste Treffer gewinnt. Ein blankes
	# reverse_proxy neben einem handle-Block würde dagegen von Caddys
	# Direktiven-Reihenfolge abhängen statt von der Lesereihenfolge.

	# Der Health-Endpunkt ist für Docker, nicht fürs Internet.
	handle /healthz {
		respond 404
	}

	# Der Host-Header MUSS unverändert durchgereicht werden: die Storefront
	# löst daraus den Tenant auf (proxy.ts). Caddy tut das bei reverse_proxy
	# standardmässig — nicht auf `header_up Host {upstream_hostport}`
	# umstellen, das liesse jede Anfrage in einen 404 laufen.
	handle {
		reverse_proxy storefront:3000
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		# Keine PSP-Hosts in der CSP: der Checkout übergibt per VOLLSTÄNDIGER
		# Weiterleitung an die gehostete zahls.ch-Bezahlseite (eigene Origin,
		# eigene Policy). Die Storefront lädt selbst kein PSP-Script und
		# spricht die PSP-API nie direkt an — das tut nur das Backend.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://api.jibbit.ch;"
		X-XSS-Protection "0"
		-Server
	}
}
