# ─── jibbit.ch Environment Variables ─────────────────────────
# Kopiere nach .env und fülle die Werte aus.

# PostgreSQL
POSTGRES_PASSWORD=medusa_dev_password

# Node
NODE_ENV=development

# Medusa
MEDUSA_BACKEND_URL=http://localhost:9000

# Session-Secrets — Pflicht. Ohne diese Werte startet docker compose nicht.
# Erzeugen mit: openssl rand -base64 32
JWT_SECRET=
COOKIE_SECRET=
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:8000

# Payrexx (https://admin.payrexx.com → API & Integrations)
PAYREXX_INSTANCE=
PAYREXX_API_SECRET=
PAYREXX_WEBHOOK_SECRET=
PAYREXX_ENABLED_PSPS=
# PSP IDs für TWINT und Powerpay findest du unter:
# https://developers.payrexx.com/reference/retrieve-all-payment-providers

# Store URL (für Payment Redirects)
STORE_URL=http://localhost:8000

# SMTP (Infomaniak Mail oder Resend)
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@jibbit.ch

# ─── Domains ─────────────────────────────────────────────────────────
# Fuer welche Domains Caddy Zertifikate holt.
#
# WICHTIG: Hier darf nur stehen, was per DNS bereits auf DIESE Maschine
# zeigt. Caddy versucht beim Start sofort ein Zertifikat; zeigt der DNS
# noch woanders hin (etwa auf die alte Odoo-Instanz), scheitert die
# ACME-Pruefung wiederholt und Let's Encrypt sperrt den Hostnamen fuer
# Stunden — ausgerechnet dann, wenn man umziehen will.
#
# Testbetrieb parallel zur alten Instanz (jibbit.ch bleibt bei Odoo):
#   SHOP_DOMAINS=test.jibbit.ch
#   API_DOMAIN=api-test.jibbit.ch
#
# Nach dem Umzug:
#   SHOP_DOMAINS=jibbit.ch, www.jibbit.ch
#   API_DOMAIN=api.jibbit.ch
SHOP_DOMAINS=test.jibbit.ch
API_DOMAIN=api-test.jibbit.ch
