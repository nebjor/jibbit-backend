# ─── jibbit.ch Environment Variables ─────────────────────────
# Kopiere nach .env und fülle die Werte aus.

# PostgreSQL
POSTGRES_PASSWORD=medusa_dev_password

# Node
NODE_ENV=development

# Medusa
MEDUSA_BACKEND_URL=http://localhost:9000

# ─── Bildoptimierung beim Upload ─────────────────────────────────────────
# Jedes im Admin hochgeladene BILD wird vor dem Ablegen verkleinert und neu
# kodiert (backend/src/modules/optimized-file). Nicht-Bilder, animierte GIFs
# und kaputte Dateien laufen unveraendert durch — ein Upload geht nie
# verloren. Alle drei Werte sind OPTIONAL, die Vorgaben stehen unten.
#
#   UPLOAD_IMAGE_FORMAT         avif | webp | jpeg | png | off   (Vorgabe: avif)
#                               off = Optimierung komplett abschalten.
#                               AVIF komprimiert am besten, braucht beim
#                               Upload aber mehrere Sekunden Rechenzeit pro
#                               Foto; webp ist deutlich schneller und kaum
#                               groesser. Beide werden von allen aktuellen
#                               Browsern angezeigt.
#   UPLOAD_IMAGE_QUALITY        1–100 (Vorgabe: sharp-Default des Formats,
#                               avif 50 / webp 80 / jpeg 80). Die Skalen der
#                               Formate sind NICHT vergleichbar.
#   UPLOAD_IMAGE_MAX_DIMENSION  Maximale Kantenlaenge in Pixeln (Vorgabe:
#                               2000). Es wird NUR verkleinert, nie
#                               hochskaliert.
#
# WICHTIG: Jeder Wert hier muss auch in docker-compose.yml unter environment:
# stehen, sonst erreicht er den Container nie — dort sind alle drei
# eingetragen.
# UPLOAD_IMAGE_FORMAT=avif
# UPLOAD_IMAGE_QUALITY=
# UPLOAD_IMAGE_MAX_DIMENSION=2000

# Session-Secrets — Pflicht. Ohne diese Werte startet docker compose nicht.
# Erzeugen mit: openssl rand -base64 32
JWT_SECRET=
COOKIE_SECRET=
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:8000

# ─── zahls.ch — OFFIZIELLES Plugin (@zahls/medusa-plugin) ────────────────
# Der einzige Zahlungsanbieter dieses Shops. Details: docs/zahls-plugin.md.
#
# Es braucht GENAU DREI Werte, alle aus dem zahls.ch-Backend
# (<instanz>.zahls.ch → API & Integrationen):
#
#   ZAHLS_INSTANCE       Instanzname: "beispiel" für beispiel.zahls.ch
#   ZAHLS_API_KEY        API-Schlüssel der Instanz
#   ZAHLS_WEBHOOK_SECRET Signatur-Schlüssel für X-Webhook-Signature
#
# Fehlt einer, startet der Shop trotzdem — nur ohne zahls.ch-Provider
# (Warnung im Log). Erst wenn alle drei gesetzt sind, registriert
# medusa-config.ts den Provider pp_zahls_zahls.
#
# TESTMODUS: steht das zahls.ch-Konto auf TEST MODUS, gelten die TEST-
# Schlüssel derselben Instanz — gleiche Variablen, keine weiteren Schalter.
#
# ┌─────────────────────────────────────────────────────────────────────┐
# │ WEBHOOK-ADRESSE im zahls.ch-Backend (Webhooks, Typ JSON):           │
# │                                                                     │
# │   https://<API_DOMAIN>/hooks/payment/zahls_zahls                    │
# │                                                                     │
# │ (Das Plugin nutzt Medusas eingebaute Route.) zahls.ch prüft die     │
# │ Adresse beim Eintragen mit einem GET; den beantwortet               │
# │ backend/src/api/hooks/payment/zahls_zahls/route.ts.                 │
# └─────────────────────────────────────────────────────────────────────┘
#
# WICHTIG: Jeder Wert hier muss auch in docker-compose.yml unter
# environment: stehen, sonst erreicht er den Container nie (Compose reicht
# nur ausdrücklich Genanntes weiter) — dort sind alle drei eingetragen.
ZAHLS_INSTANCE=
ZAHLS_API_KEY=
ZAHLS_WEBHOOK_SECRET=
# Optional: Redirect-Ziele nach der Zahlung. Ohne Angabe leiten sie auf
# ${STORE_URL}/checkout/success|failed|cancel — für Abweichler:
# ZAHLS_SUCCESS_URL=
# ZAHLS_FAILED_URL=
# ZAHLS_CANCEL_URL=

# Store URL (für Payment Redirects UND für den Link in der
# Passwort-zurücksetzen-E-Mail).
#
# WICHTIG: Der Reset-Link wird ausschliesslich hieraus gebaut, nie aus einem
# Request-Header. Stimmt der Wert nicht mit der Domain überein, unter der die
# Storefront erreichbar ist, laufen alle Reset-Links ins Leere. Nach dem
# Umzug also auf https://jibbit.ch setzen.
STORE_URL=http://localhost:8000

# Shopname in Betreff und Text der E-Mails.
STORE_NAME=jibbit

# SMTP (Infomaniak Mail oder Resend)
#
# Ohne diese Werte startet der Stack normal, es geht nur keine E-Mail raus:
# der SMTP-Provider meldet beim ersten Versand einen klaren Fehler ins Log.
# Damit bleibt lokale Entwicklung ohne Mailkonto möglich.
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@jibbit.ch

# Nur fuer einen lokalen Mailfaenger (mailpit, mailhog): erlaubt den Versand
# ohne STARTTLS. Ohne diesen Schalter verweigert nodemailer die unsichere
# Verbindung, und der Ablauf laesst sich lokal nicht durchspielen.
# Bei NODE_ENV=production ignoriert der Provider den Schalter hart.
# SMTP_ALLOW_INSECURE=true

# ─── Domains ─────────────────────────────────────────────────────────
# Fuer welche Domains Caddy Zertifikate holt.
#
# WICHTIG: Hier darf nur stehen, was per DNS bereits auf DIESE Maschine
# zeigt. Caddy versucht beim Start sofort ein Zertifikat; zeigt der DNS
# noch woanders hin (etwa auf die alte Odoo-Instanz), scheitert die
# ACME-Pruefung wiederholt und Let's Encrypt sperrt den Hostnamen fuer
# Stunden — ausgerechnet dann, wenn man umziehen will.
#
# Testbetrieb parallel zur alten Instanz (jibbit.ch bleibt bei Odoo):
#   SHOP_DOMAINS=test.jibbit.ch
#   API_DOMAIN=api-test.jibbit.ch
#
# Nach dem Umzug:
#   SHOP_DOMAINS=jibbit.ch, www.jibbit.ch
#   API_DOMAIN=api.jibbit.ch
SHOP_DOMAINS=test.jibbit.ch
API_DOMAIN=api-test.jibbit.ch

# ─── Host-Ports der Datenbanken ──────────────────────────────────────
# Nur noetig, wenn auf der Maschine bereits Postgres oder Redis laufen —
# etwa hinter einer bestehenden Odoo-Installation. Sonst scheitert
# `docker compose up` mit "address already in use".
# MEDUSA_HOST_PORT=9001
# POSTGRES_HOST_PORT=5433
# REDIS_HOST_PORT=6380

# Nur bei einer verwalteten Datenbank mit TLS auf true setzen. Im
# Compose-Betrieb bleibt die Verbindung im Docker-Netz und braucht kein SSL —
# waere es an, scheiterten alle Migrationen.
# DATABASE_SSL=true

# ─── PostHog (Analyse der Storefront) ────────────────────────────────────
# Konto auf https://eu.posthog.com anlegen, Region EU waehlen, dann unter
# Project Settings den Project API Key kopieren (beginnt mit phc_).
#
# Beide Werte sind OPTIONAL: ohne Schluessel laedt die Storefront posthog-js
# gar nicht erst. Analyse laeuft ausserdem nur nach Einwilligung im
# Cookie-Hinweis — ohne Zustimmung wird nichts geholt und nichts gesendet.
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
