public-hoist-pattern[]=*@medusajs/*
public-hoist-pattern[]=@tanstack/react-query
public-hoist-pattern[]=react-i18next
public-hoist-pattern[]=react-router-dom

# WARUM legacy-peer-deps:
#
# @zahls/medusa-plugin@0.0.1 pinnt seine peerDependencies EXAKT auf
# @medusajs/*@2.18.0. Dieses Projekt laeuft auf 2.13.6 — npm 7+ bricht die
# Installation deshalb mit ERESOLVE ab, obwohl der Provider-Code des Plugins
# zur Laufzeit mit 2.13.6 funktioniert (verifiziert, siehe
# src/__tests__/zahls-plugin-*.unit.spec.ts und docs/zahls-plugin.md).
#
# `overrides` in package.json greifen bei peerDependencies-Konflikten NICHT
# (bekannte npm-Einschraenkung) — deshalb dieser Schalter.
#
# Die Datei MUSS im Docker-Image an zwei Stellen ankommen (siehe Dockerfile):
#   1. Builder-Stage vor `npm ci` — sonst scheitert `npm ci` am selben Konflikt.
#   2. Runner-Stage vor `npm install --omit=dev` — dito.
#
# Beim Upgrade des Projekts auf Medusa 2.18.x: Schalter entfernen und pruefen,
# dass die Installation wieder ohne ihn durchlaeuft.
legacy-peer-deps=true