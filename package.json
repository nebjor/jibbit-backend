{
  "name": "jibbit-ch",
  "version": "0.0.1",
  "private": true,
  "description": "jibbit.ch — Swiss headless e-commerce (MedusaJS v2 monorepo)",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=backend",
    "start": "npm run start --workspace=backend",
    "seed": "npm run seed --workspace=backend",
    "db:migrate": "cd backend && npx medusa db:migrate",
    "prepare-images": "node scripts/prepare-product-images.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "sharp": "^0.34.5"
  }
}
